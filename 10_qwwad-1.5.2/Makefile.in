	-rm -rf gtest/src/$(DEPDIR) src/$(DEPDIR) src/qwwad/$(DEPDIR) tests/integration_tests/$(DEPDIR) tests/microtests/schroedinger_solver_tests/$(DEPDIR)
	-rm -f Makefile
